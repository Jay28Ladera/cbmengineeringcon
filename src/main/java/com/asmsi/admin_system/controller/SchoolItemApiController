package com.asmsi.admin_system.controller;


import com.asmsi.admin_system.dto.SchoolItemDetailDTO;
import com.asmsi.admin_system.dto.SchoolItemLiteDTO;
import com.asmsi.admin_system.service.SchoolItemService;
import org.springframework.data.domain.*;
import org.springframework.web.bind.annotation.*;

import java.util.HashMap;
import java.util.Map;

@RestController
@RequestMapping("/api/schoolitems")
public class SchoolItemApiController {

    private final SchoolItemService schoolItemService;

    public SchoolItemApiController(SchoolItemService schoolItemService) {
        this.schoolItemService = schoolItemService;
    }

    // ✅ DataTables server-side endpoint
    @GetMapping("/datatables")
    public Map<String, Object> datatables(
            @RequestParam int draw,
            @RequestParam int start,
            @RequestParam int length,
            @RequestParam(value = "search[value]", required = false) String searchValue,
            @RequestParam(value = "order[0][column]", required = false) Integer orderColumn,
            @RequestParam(value = "order[0][dir]", required = false) String orderDir
    ) {
        if (length <= 0) length = 10;
        int page = start / length;

        // DataTables columns:
        // 0 = picture (not sortable)
        // 1 = itemCode
        // 2 = itemName
        // 3 = quantityOnHand
        // 4 = shops
        // 5 = status
        String sortField = switch (orderColumn == null ? 1 : orderColumn) {
            case 1 -> "itemCode";
            case 2 -> "itemName";
            case 3 -> "quantityOnHand";
            case 4 -> "shops";
            case 5 -> "status";
            default -> "itemCode";
        };

        Sort.Direction dir = "desc".equalsIgnoreCase(orderDir) ? Sort.Direction.DESC : Sort.Direction.ASC;
        Pageable pageable = PageRequest.of(page, length, Sort.by(dir, sortField));

        Page<SchoolItemLiteDTO> result = schoolItemService.datatablesLite(searchValue, pageable);

        Map<String, Object> out = new HashMap<>();
        out.put("draw", draw);
        out.put("recordsTotal", schoolItemService.countAll());
        out.put("recordsFiltered", result.getTotalElements());
        out.put("data", result.getContent());
        return out;
    }

    // ✅ Preview details endpoint
    @GetMapping("/{id}")
    public SchoolItemDetailDTO detail(@PathVariable Long id) {
        return schoolItemService.getDetail(id);
    }
}
